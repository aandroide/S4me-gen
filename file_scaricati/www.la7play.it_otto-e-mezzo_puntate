olazione.\u0026nbsp;\u003c/p\u003e\u003cp\u003eLilli Gruber ne discute con: Cathy La Torre, Brunella Bolloli, Tito Boeri, Tomaso Montanari. Attraverso punti di vista differenti, gli ospiti analizzano l'andamento dell'economia italiana, le responsabilità politiche e le possibili risposte a una delle questioni più delicate dell'attualità economica.\u003c/p\u003e3b:[\"$\",\"div\",null,{\"className\":\"flex flex-row px-6 xl:px-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col h-full w-full py-8 lg:py-16\",\"children\":[[\"$\",\"$L3c\",null,{\"seasons\":[{\"id\":\"99104\",\"name\":\"26\"}],\"currentStagione\":\"$undefined\",\"currentSort\":\"desc\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 lg:grid-cols-4 gap-6 mb-6\",\"children\":[[\"$\",\"$L3d\",\"394647\",{\"index\":0,\"data\":{\"id\":\"394647\",\"title\":\"La propaganda di Meloni e la verità dei numeri - Puntata del 30/9/2026\",\"tags\":null,\"path\":\"/otto-e-mezzo/puntate/puntata-del-30-9-2026-394647\",\"property\":{\"id\":\"549\",\"name\":\"Otto e mezzo\",\"titolo\":\"Otto e mezzo\",\"description\":{\"value\":\"\u003cp\u003eOtto e mezzo\u003c/p\u003e\",\"plainValue\":\"Otto e mezzo\"}},\"created\":{\"timestamp\":1790798014,\"time\":\"2026-09-30T19:53:34+00:00\"},\"body\":{\"value\":\"$3e\",\"summary\":\"\"},\"smartTvLocandina\":null,\"dataMessaInOnda\":{\"timestamp\":1790793563,\"time\":\"2026-09-30T18:39:23+00:00\"},\"numeroEpisodio\":13,\"numeroStagione\":{\"name\":\"26\"},\"urlVideo\":null,\"uploadVideo\":{\"cf_duration\":\"2044\",\"cf_entry_id\":\"0_oyni34u1\",\"cf_thumbnail_url\":\"https://images.la7play.it/video/0/399/0_oyni34u1_0_3zjvar1f_12/la-propaganda-di-meloni-e-la-verita-dei-numeri-puntata-del-3/scena-854x480.webp\",\"thumbnailDefault\":{\"url\":\"https://images.la7play.it/video/0/399/0_oyni34u1_0_3zjvar1f_12/la-propaganda-di-meloni-e-la-verita-dei-numeri-puntata-del-3/scena-854x480.webp\",\"variations\":[{\"style\":\"scena_lg\",\"url\":\"https://images.la7play.it/video