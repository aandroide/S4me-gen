s\":[\"/8aUeas22WSPfPVGZ5YBjGnJ9Y1g.svg\",\"/twD0R1O15sPKDzUoJafwkm7fxCC.png\",\"/8CLKf7MAO0akAzHhrDprVt7jSmG.svg\",\"/pvoDsfVVEUSUGF7oiySP17Zj1QY.png\",\"/vzC4XYQjoXXAN1F7PEdsaB7Q6mu.png\"],\"backdropClean\":[\"/h050XJoiIobaH6bhj3MAhgilkpJ.jpg\",\"/lzQar2yH8EQAk72c8xlF65yP3tl.jpg\",\"/cECKQLktgSIR2HcdnGV8Ftfyl9p.jpg\",\"/1KxLxLcMZbtR3Jf32s2jhvZzA6r.jpg\",\"/d8dunoo0lp2bw0R2Uea5yXy1URs.jpg\"],\"backdropText\":[\"/ygOaYjqTeGZEHprKh2lWzPc1RdO.jpg\",\"/b7AmmXXzuzi2AyhvxEe1pU2deFt.jpg\",\"/jS2exKFPtf9VNYBYu5Kowf3EmVi.jpg\",\"/i3qYGx6uVZNV1r7qCNkDUgFrJUz.jpg\",\"/zz3fpGUKRMUNLJ4iYOw0Ej2Oe96.jpg\"],\"posterSel\":\"/6njUqsd3By2mJsdZm1P0moPLzs3.jpg\",\"logoSel\":\"/8aUeas22WSPfPVGZ5YBjGnJ9Y1g.svg\",\"backdropSel\":\"/ygOaYjqTeGZEHprKh2lWzPc1RdO.jpg\",\"backdropSelClean\":\"/h050XJoiIobaH6bhj3MAhgilkpJ.jpg\",\"hasImg\":true,\"searchBlob\":\"9-1-1 9-1-1 9-1-1 9-1-1\",\"numberOfSeasons\":9,\"numberOfEpisodes\":142,\"createdAt\":\"2026-02-12T02:40:46.000Z\",\"updatedAt\":\"2026-06-15T13:53:49.776Z\",\"cleanUrl\":\"https://img.altadefinizionex.vip/t/p/w780/h050XJoiIobaH6bhj3MAhgilkpJ.jpg\",\"noBackdrop\":false},{\"id\":25121,\"kind\":\"series\",\"title\":\"Grey's Anatomy\",\"originalTitle\":\"Grey's Anatomy\",\"slug\":\"greys-anatomy\",\"year\":2005,\"plot\":\"Meredith Grey è una giovane ragazza di Boston che, dopo la laurea in medicina, riesce ad entrare nel gruppo di tirocinanti di chirurgia del Seattle Grace Hospital. Si trasferisce così a Seattle, nella vecchia casa appartenuta alla madre. Qui si ritrova a condividere questa nuova esperienza insieme ad un gruppo di giovani coetanei, tutti alle prese con i più svariati problemi. Meredith è figlia di Ellis Grey, una famosa dottoressa specialista in chirurgia generale, e sente molto il peso del suo cognome. La sera prima di iniziare il tirocinio, Meredith incontra in un pub Derek, un affascinante uomo con cui passa la notte; solo il giorno dopo scopre che in realtà lui è Derek Shepherd, neurochirurgo dell'ospedale, nonché suo supervisore. Meredith deve così districarsi tra lo studio e il lavoro per poter diventare un chirurgo, e i sentimenti che prova per Derek.\",\"posterUrl\":\"https://img.altadefinizionex.vip/t/p/w500/jcEl8SISNfGdlQFwLzeEtsjDvpw.jpg\",\"tileUrl\":\"https://img.altadefinizionex.vip/t/p/w780/aCQEM33YWvZm0hYfQ4R1I6srV19.jpg\",\"backdropUrl\":\"https://img.altadefinizionex.vip/t/p/w1280/jP0Rhj9OTPDAwQlHQwOLFDdeE8t.jpg\",\"logoUrl\":\"https://img.altadefinizionex.vip/t/p/w500/keAZqhg9lmOHEhmG5njqIsuxf0f.png\",\"imdbId\":\"tt0413573\",\"tmdbId\":1416,\"tvdbId\":73762,\"wikidataId\":\"Q438406\",\"rating\":\"8.21\",\"durationMin\":null,\"country\":\"USA\",\"director\":null,\"cast\":\"Ellen Pompeo, Chandra Wilson, James Pickens Jr., Caterina Scorsone, Camilla Luddington, Kevin McKidd, Kim Raver, Jason George, Chris Carmack, Anthony Hill, Adelaide Kane, Alexis Floyd, Niko Terho, Harry Shum Jr., Trevor Jackson\",\"quality\":null,\"trailerKey\":\"q1pcpgREQ5c\",\"genres\":[\"Drammatico\"],\"status\":\"published\",\"hero\":false,\"upcoming\":false,\"heroOrder\":null,\"heroPosition\":45,\"heroScale\":null,\"heroTrailer\":true,\"scTrailer\":true,\"legacyId\":25121,\"legacyUrl\":\"/titles/25121-guarda-greys-anatomy-21-stagione-streaming.html\",\"titleIt\":\"Grey's Anatomy\",\"titleEn\":\"Grey's Anatomy\",\"tagline\":\"La vita che salvi potrebbe essere la tua.\",\"releaseDate\":\"2005-03-27\",\"releaseStatus\":\"Returning Series\",\"originalLanguage\":\"en\",\"certification\":null,\"voteCount\":10927,\"userRating\":\"7.0\",\"userVotes\":89,\"inCinema\":false,\"inCinemaManual\":false,\"subIta\":false,\"popularity\":\"225.2045\",\"views\":816785,\"productionCountries\":[\"United States of America\",\"Canada\"],\"spokenLanguages\":[\"English\"],\"productionCompanies\":[\"The Mark Gordon Company\",\"shondaland\",\"ABC Studios\",\"Touchstone Television\",\"Entertainment One Television\",\"Lionsgate Television\",\"ABC Signature\",\"Trip the Light Productions\",\"20th Television\"],\"keywords\