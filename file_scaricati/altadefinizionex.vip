jpg\",\"/3SsyqOfVr3uCODiGrLWk5qXXpDU.jpg\"],\"logoPaths\":[],\"backdropClean\":[\"/w5x5weniCCe0rs8lsW1XPhQxbKS.jpg\",\"/iuZL8WhPjcqYsKw0NE46IZHiJSk.jpg\"],\"backdropText\":[],\"posterSel\":\"/e0mc2OSX6jRaWBFS0CJbKzJ7rGy.jpg\",\"logoSel\":null,\"backdropSel\":\"/w5x5weniCCe0rs8lsW1XPhQxbKS.jpg\",\"backdropSelClean\":\"/w5x5weniCCe0rs8lsW1XPhQxbKS.jpg\",\"hasImg\":true,\"searchBlob\":\"cos'e l'amore? cos'e l'amore? what is love? c'est quoi l'amour ?\",\"numberOfSeasons\":null,\"numberOfEpisodes\":null,\"createdAt\":\"2026-10-24T09:38:03.690Z\",\"updatedAt\":\"2026-10-24T09:38:03.690Z\",\"cleanUrl\":\"https://img.altadefinizionex.vip/t/p/w780/w5x5weniCCe0rs8lsW1XPhQxbKS.jpg\",\"noBackdrop\":true},{\"id\":45337,\"kind\":\"movie\",\"title\":\"Rebuilding – Come l’acqua per il fuoco\",\"originalTitle\":\"Rebuilding\",\"slug\":\"rebuilding-come-lacqua-per-il-fuoco\",\"year\":2025,\"plot\":\"Un incendio ha appena distrutto il suo ranch familiare di duecento settanta acri: tutte le sue amate mucche vanno vendute. Il giovane Dusty, strappato al suo amato allevamento, vive come un reduce di sé stesso, arrangiandosi con lavoretti a giornata. Cowboy malinconico e solitario, dorme in una piccola roulotte allestita in un campo emergenze dove, giorno dopo giorno, combattendo l'iniziale ritrosia, inizia a solidarizzare con le altre persone sfollate. Nel frattempo, intanto, è chiamato a ricucire i rapporti con la piccola Callie-Rose avuta dall'ex compagna Ruby, senza smettere di sognare, però, di riaprire un giorno la sua fattoria, ripiantare tutti gli alberi e lasciarci pascolare di nuovo gli animali.\",\"posterUrl\":\"https://img.altadefinizionex.vip/t/p/w500/6ExQWW835gWGP7abNBSG3ePJGC.jpg\",\"tileUrl\":\"https://img.altadefinizionex.vip/t/p/w780/6KZHWW24QKg0KxILGDoCXF9do9m.jpg\",\"backdropUrl\":\"https://img.altadefinizionex.vip/t/p/w1280/zfhAzbZXg24Z9INMcRfkr45mH91.jpg\",\"logoUrl\":\"https://img.altadefinizionex.vip/t/p/w500/duncjyWrayimhgKnSX8rewqHdtI.png\",\"imdbId\":\"tt293619