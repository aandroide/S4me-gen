var overlapElement = function(el, zindex, depth) {

    var a = el;
    var overlap = false;
    for (var i = 0; i < a.children.length; i++) {
        if (parseInt(a.style.zIndex) > zindex) {
            overlap = true;
            break;
        }
        if (a.children[i].style.zIndex == "") {
            if (depth > 0) {
                var child = a.children[i];
                for (var k = 0; k < child.children.length; k++) {
                    if (parseInt(child.children[k].style.zIndex) > zindex && (parseInt(a.children[i].style.opacity) > 0 || a.children[i].style.opacity == "")) {
                        overlap = true;
                        break;
                    }
                }
            }
        } else if (parseInt(a.children[i].style.zIndex) > zindex && (parseInt(a.children[i].style.opacity) > 0 || a.children[i].style.opacity == "")) {
            if (parseInt(a.children[i].style.top) > 0) continue;
            overlap = true;
            break;
        }
    }
    return overlap;
}
