-mezzo/podcast\",\"className\":\"cursor-pointer\",\"data-la7-tid\":\"549\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-lg aspect-square\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.la7play.it/media/c/t1790924678/property/podcast/ottoemezzo_2.jpg/img/400x400.webp\",\"alt\":\"Otto e mezzo\",\"srcSet\":\"$undefined\",\"sizes\":\"$undefined\",\"className\":\"absolute inset-0 h-full w-full object-cover rounded-lg\",\"loading\":\"lazy\",\"fetchPriority\":\"$undefined\",\"decoding\":\"async\",\"width\":400,\"height\":400}]}]}],[\"$\",\"a\",\"3\",{\"href\":\"/in-onda/podcast\",\"className\":\"cursor-pointer\",\"data-la7-tid\":\"496\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-lg aspect-square\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.la7play.it/media/c/t1790924929/property/podcast/inonda.jpg/img/400x400.webp\",\"alt\":\"In Onda\",\"srcSet\":\"$undefined\",\"sizes\":\"$undefined\",\"className\":\"absolute inset-0 h-full w-full object-cover rounded-lg\",\"loading\":\"lazy\",\"fetchPriority\":\"$undefined\",\"decoding\":\"async\",\"width\":400,\"height\":400}]}]}],[\"$\",\"a\",\"4\",{\"href\":\"/piazzapulita/podcast\",\"className\":\"cursor-pointer\",\"data-la7-tid\":\"548\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-lg aspect-square\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.la7play.it/media/c/t1790924716/property/podcast/piazza.jpg/img/400x400.webp\",\"alt\":\"Piazzapulita\",\"srcSet\":\"$undefined\",\"sizes\":\"$undefined\",\"className\":\"absolute inset-0 h-full w-full object-cover rounded-lg\",\"loading\":\"lazy\",\"fetchPriority\":\"$undefined\",\"decoding\":\"async\",\"width\":400,\"height\":400}]}]}],[\"$\",\"a\",\"5\",{\"href\":\"/propagandalive/podcast\",\"className\":\"cursor-pointer\",\"data-la7-tid\":\"441\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-lg aspect-square\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.la7play.it/media/c/t1790925070/property/podcast/propaganda.jpg/img/400x400.webp\",\"alt\":\"Propaganda Live\",\"srcSet\":\"$undefined\",\"sizes\":\"$undefined\",\"className\":\"absolute inset-0 h-full w-full object-cover rounded-lg\",\"loading\":\"lazy\",\"fetchPriority\":\"$undefined\",\"decoding\":\"async\",\"width\":400,\"height\":400}]}]}],[\"$\",\"a\",\"6\",{\"href\":\"/il-palazzo/podcast\",\"className\":\"cursor-pointer\",\"data-la7-tid\":\"291\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-lg aspect-square\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.la7play.it/media/c/t1746691132/1400_2.jpg/img/400x400.webp\",\"alt\":\"Il palazzo\",\"srcSet\":\"$undefined\",\"sizes\":\"$undefined\",\"className\":\"absolute inset-0 h-full w-full object-cover rounded-lg\",\"loading\":\"lazy\",\"fetchPriority\":\"$undefined\",\"decoding\":\"async\",\"width\":400,\"height\":400}]}]}],\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\"]}],false]}]]}]\n"])</script><div hidden id="S:1"><script>window.RCSAD_sitepage="La7.it/pagine";window.LA7_pagetype="sezione";window.property=null;window.__ADV_SERVER_RENDERED=true;window.RCSAD_disabled=true;</script><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://www.la7play.it/#website","url":"https://www.la7play.it/","name":"LA7","alternateName":"LA7 Play","description":"LA7 S.p.A. è la società del Gruppo Cairo Communication che opera nel settore televisivo attraverso i canali LA7 e LA7 Cinema.","publisher":{"@id":"https://www.la7play.it/#organization"},"inLanguage":"it-IT"},{"@type":"NewsMediaOrganization","@id":"https://www.la7play.it/#organization","name":"LA7","url":"https://www.la7play.it/","logo":{"@type":"ImageObject","@id":"https://www.la7play.it/#logo","url":"https://www.la7play.it/assets/img/la7-logo.svg"}},{"@type":"CollectionPage","@id":"https://www.la7play.it/podcast#webpage","url":"https://www.la7play.it/podcast","name":"Podcast","description":"I podcast di LA7 ovunque con te. In questa pagina sono disponibili in modalità solo audio i podcast dei nostri programmi","isPartOf":{"@id":"https://www.la7play.it/#website"},"publisher":{"@id":"https://www.la7play.it/#organization"},"breadcrumb":{"@id":"https://www.la7play.it/podcast#breadcrumb"},"mainEntity":{"@id":"https://www.la7play.it/podcast#itemlist"},"inLanguage":"it-IT"},{"@type":"BreadcrumbList","@id":"https://www.la7play.it/podcast#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.la7play.it/"},{"@type":"ListItem","position":2,"name":"Podcast","item":"https://www.la7play.it/podcast"}]},{"@type":"ItemList","@id":"https://www.la7play.it/podcast#itemlist","url":"https://www.la7play.it/podcast","name":"Podcast","numberOfItems":17,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/buongiornomondo/podcast#podcast-series","name":"BuongiornoMondo","url":"https://www.la7play.it/buongiornomondo/podcast","description":"Una rassegna stampa curata da Elena Testi delle notizie più importanti e delle tendenze globali che stanno plasmando la società contemporanea","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/1400.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/5zxzaIZH6AJleYEZGbCBLA?si=3c8ac609495f4bd7","https://podcasts.apple.com/it/podcast/buongiornomondo/id1791104321","https://youtube.com/playlist?list=PLTQLA-sdhEzRI4sGk5Pin7HUMOvs0ySJL&feature=shared","https://music.amazon.it/podcasts/3f88342c-898b-4566-b384-4771c62a1a6c/buongiornomondo"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":2,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/tgla7/podcast#podcast-series","name":"Tg La7","url":"https://www.la7play.it/tgla7/podcast","description":"Le edizioni integrali del TGLA7 diretto da Enrico Mentana","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790925247/property/podcast/tg.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/5VgLr9YMZXRQKtLiYesklR?si=273e6ec794764510","https://podcasts.apple.com/it/podcast/tg-la7/id1511917213","https://youtube.com/playlist?list=PLrCZBOonghGMsmGc-_8BCIv-xkm-H_GV6&si=DdRqmGUvkxu7hq58","https://music.amazon.it/podcasts/bc3a0acb-2c0c-4643-ad6f-24511e51b43b/tg-la7"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":3,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/otto-e-mezzo/podcast#podcast-series","name":"Otto e mezzo","url":"https://www.la7play.it/otto-e-mezzo/podcast","description":"Ascolta il racconto dell'attualità con Lilli Gruber e i suoi ospiti. Tutti i giorni le puntate integrali di Otto e Mezzo.","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790924678/property/podcast/ottoemezzo_2.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/6bxbMH41BT51gL7cpFNosL?si=8a9b14304c7d41aa","https://podcasts.apple.com/it/podcast/otto-e-mezzo/id1511482217","https://youtube.com/playlist?list=PLTQLA-sdhEzT52jBz1sHC42B-0ahp_Yyo&si=Yfxz2MuoUDjo8s6v","https://music.amazon.it/podcasts/d8a23a0e-d52c-4dd7-857b-776f2f656a2e/otto-e-mezzo"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":4,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/in-onda/podcast#podcast-series","name":"In Onda","url":"https://www.la7play.it/in-onda/podcast","description":"L'approfondimento dei temi del giorno con Marianna Aprile e Luca Telese","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790924929/property/podcast/inonda.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/5lzqCVqQNUNbvOUKw49JcM?si=69b9284661e541b8","https://podcasts.apple.com/it/podcast/in-onda/id1521428014","https://youtube.com/playlist?list=PLTQLA-sdhEzRuNTEeOg9GOSQBPJBfEwMf&si=vfx79GuAYFg_QDAQ","https://music.amazon.it/podcasts/e50ed1b5-5fb6-4c6f-87be-986dcc9e0c28/in-onda"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":5,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/piazzapulita/podcast#podcast-series","name":"Piazzapulita","url":"https://www.la7play.it/piazzapulita/podcast","description":"Le interviste di Corrado Formigli","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790924716/property/podcast/piazza.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/7mwOijaCikTGaGOI8iDivN?si=2e01cf46abf64dab","https://podcasts.apple.com/it/podcast/piazzapulita/id1502081457","https://youtu.be/U7gYeK9YrgA?si=SbnerV1P4qeAtPKf"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":6,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/propagandalive/podcast#podcast-series","name":"Propaganda Live","url":"https://www.la7play.it/propagandalive/podcast","description":"Le interviste di Diego Bianchi","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790925070/property/podcast/propaganda.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/5RWifGYT34BRVDj8E5mxSC","https://podcasts.apple.com/it/podcast/propaganda-live/id1502081648?l=en-GB","https://www.youtube.com/playlist?list=PLTQLA-sdhEzQ6n7QzGOwJUfbnWsVvaB4l","https://www.amazon.it/music/player/artists/B008QCTU8M/propaganda"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":7,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/il-palazzo/podcast#podcast-series","name":"Il palazzo","url":"https://www.la7play.it/il-palazzo/podcast","description":"“Signor Presidente, Onorevoli colleghi…”. Iniziano tutti così gli interventi in aula di deputati e senatori. Poi può seguire un discorso che commuove, che indigna, che fa morir dal ridere. Dipende. Tutti i discorsi però nascondono una storia. E “Il Palazzo” la racconta. Il Palazzo è un podcast di La7, prodotto da La7 Scritto da Luca Sappino e Matteo Marchetti","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/1400_2.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/2ZabaVduLmBeUI6WLgEICX","https://podcasts.apple.com/us/podcast/il-palazzo/id1805200567","https://music.amazon.it/podcasts/822cfdad-ac1a-4321-ab79-2ab923d4948a/il-palazzo","https://youtu.be/cH8PG16kdDE?si=MviqJjTW2VyedC06"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":8,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/dimartedi/podcast#podcast-series","name":"diMartedì","url":"https://www.la7play.it/dimartedi/podcast","description":"Le interviste di Giovanni Floris","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790927108/property/podcast/dimartedì.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/0WE3wRPgNlAkJG19C7puH5?si=901b086303d5429e","https://podcasts.apple.com/it/podcast/dimartedi/id1502081325","https://music.amazon.it/podcasts/2bc1b5e1-7ba6-4597-ad78-abf3660a75ad/dimartedi","https://youtube.com/playlist?list=PLy4ldP4vb5KfamKz3iMIBQYE1BEhfH2qw&si=LOPUu5O5N9rHnBXC"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":9,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/sete/podcast#podcast-series","name":"Sete","url":"https://www.la7play.it/sete/podcast","description":"Il cambiamento climatico sta già trasformando il volto del nostro pianeta, portando con sé sfide che richiedono risposte rapide e innovative. I segni di un mondo che sta cambiando, dalle ondate di calore sempre più frequenti all’innalzamento del livello del mare, sono ormai evidenti. Tuttavia, l'impatto non si limita all'ambiente naturale: nessun aspetto della nostra vita ne è immune. Elena Testi ci accompagna attraverso le molteplici dimensioni di questa sfida globale, che non riguarda solo la scienza o la politica, ma l’intera umanità.","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/1400_0.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/0OFnkOBSypDtXK9zoNrkIY","https://podcasts.apple.com/us/podcast/sete-unindagine-sul-futuro-che-ci-attende/id1802636827","https://www.youtube.com/playlist?list=PLTQLA-sdhEzTB-7yJld7KaZbxgdGIyMIK","https://music.amazon.it/podcasts/bccab04c-9324-4045-994d-97b55d64ac14/sete---un'indagine-sul-futuro-che-ci-attende"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":10,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/europost/podcast#podcast-series","name":"Europost","url":"https://www.la7play.it/europost/podcast","description":"Le piazze in protesta, i corridoi di Bruxelles, le notti elettorali e i grandi vertici, i racconti dei protagonisti. Questo è Europost, il podcast di la7 che ogni settimana vi porta in Europa, lì dove l’Unione europea si fa o si distrugge.","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/1400_1.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/4BZERxSlCDiZY8zSecjmeJ","https://podcasts.apple.com/it/podcast/europost/id1796177928","https://music.amazon.it/podcasts/c0604311-b044-40ed-ad93-35e96faef89e","https://youtube.com/playlist?list=PLTQLA-sdhEzQt0OvVOg15DHGhTY0pJ0qJ&si=vQbnWIzTG4PjJegM"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":11,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/voto-piu-voto-meno/podcast#podcast-series","name":"Voto più, voto meno","url":"https://www.la7play.it/voto-piu-voto-meno/podcast","description":"Dare i voti è uno sporco mestiere, ma qualcuno deve pur farlo. Perché, per capire ciò che ci succede intorno, a volte bisogna prendere la matita rossa e segnare gli strafalcioni, le battute memorabili, le imprese e le prodezze di ieri e di oggi. Sono Paolo Celata e questo è il podcast \"Voto più, Voto meno\". In ogni puntata troverete la mia pagella su personaggi, argomenti e fatti che mi hanno colpito, stupito o stordito nel corso dell’ultima settimana. Questi sono i miei insindacabili voti. Se non vi piacciono, ne ho altri.","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/celata-media.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/7hVPYQ6tAy4AavoAnhHlvo?si=s5yAs1qwRUC4b53sjRlcvQ&nd=1&dlsi=9a2f34452de74503","https://podcasts.apple.com/us/podcast/voto-pi%C3%B9-voto-meno/id1795053114","https://music.amazon.it/podcasts/0b892ae0-d216-42dd-a2d1-deb5c6826550/voto-pi%C3%B9-voto-meno","https://youtube.com/playlist?list=PLTQLA-sdhEzSz81ASwkb7vISfCL8edK7X&si=EttfbVxFIcOYJ_3s"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":12,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/in-altre-parole/podcast#podcast-series","name":"In altre parole","url":"https://www.la7play.it/in-altre-parole/podcast","description":"In altre Parole, un altro modo di guardare al presente, di essere dentro la realtà e di raccontare i sette giorni appena trascorsi attraverso lo sguardo e il pensiero di Massimo Gramellini. La domenica, l'inserto culturale del programma, dove Massimo Gramellini insieme ai suoi ospiti riflette e approfondisce un argomento che scalda il dibattito del nostro Paese, cercando di contaminare linguaggi e visioni differenti.","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1790924850/property/podcast/in-altre-parole_0.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/1ME7rRDxIKVU6QOaiBWaWA?si=fd43848ea5814eb2","https://podcasts.apple.com/it/podcast/in-altre-parole/id1733457418","https://youtube.com/playlist?list=PLTQLA-sdhEzQ45HV63Nc8sTdXHAvXm3Cl&si=7p9uKGztuh3RSoHj","https://music.amazon.it/podcasts/33c21a3f-9006-4083-82fe-208600f6853a/episodes/a00be202-d139-4180-9f2e-a3cb8a1bea4f/in-altre-parole-in-altre-parole"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":13,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/trumpology-nella-mente-di-donald-trump/podcast#podcast-series","name":"Trumpology - Nella mente di Donald Trump","url":"https://www.la7play.it/trumpology-nella-mente-di-donald-trump/podcast","description":"Guerre commerciali dazi alle stelle, improvvisi cambi di decisione, proclami di annessione, insulti agli alleati, espansione del potere presidenziale oltre le salvaguardie costituzionali, compressione dei diritti, frontiere blindate, deportazioni di massa. Il mondo osserva sotto choc il ritorno al potere di Donald Trump, sbigottito ed inerme davanti ad ogni nuova decisione del presidente americano. Ma possiamo davvero essere sopresi? Trumpology è il tentativo di entrare nella mente di Donald Trump e nello spirito dell’America arrabbiata che incarna per non farci cogliere più con la guardia abbassata perché, se abbiamo un' unica certezza è che Donald Trump è Donald Trump, lo è sempre stato e lo sarà sempre. Un podcast di Damiano Ficoneri","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/cover_trumpology_1400.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/7EgdeicQnlZ7az4oSGiMdD","https://podcasts.apple.com/us/podcast/trumpology-nella-mente-di-donald-trump/id1809400074","https://music.amazon.it/podcasts/ba369c8d-7acc-41fc-b826-2b00f28d8b55/trumpology-nella-mente-di-donald-trump","https://www.youtube.com/playlist?list=PLTQLA-sdhEzRGDVdI76GZuFgvNbpSAbXY"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":14,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/il-fattore-economico/podcast#podcast-series","name":"Il fattore economico","url":"https://www.la7play.it/il-fattore-economico/podcast","description":"Le grandi manovre economiche sembrano complicatissime ma in realtà si ripercuotono sulla vita di ognuno di noi, ogni giorno. \"Il fattore economico\" vuole rendere una materia che sembra complicata, digeribile per tutti. I dazi, cosa c'è da sapere e come si ripercuotono anche sui piccoli risparmiatori? I mercati, dove investire quando regnano l'incertezza e il caos? Come capire le Borse, le criptovalute, cosa sono, il bitcoin salirà ancora o crollerà? Il caro bollette, come difendersi? Carla Rumor, della redazione economia del TgLa7, ti spiega grandi e piccole notizie economiche e soprattutto, come fare a tenerne conto.","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/1400_3.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/3wHvoIeqcRC2MtLYOvSBma","https://podcasts.apple.com/us/podcast/il-fattore-economico/id1810470681","https://music.amazon.it/podcasts/2744dd14-a491-4c90-8526-fa478f5a3491/il-fattore-economico","https://www.youtube.com/playlist?list=PLrCZBOonghGPM1FVGrSuFHsc8rLkTF1z8"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":15,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/euro-dieci/podcast#podcast-series","name":"Euro Dieci","url":"https://www.la7play.it/euro-dieci/podcast","description":"Euro Dieci il podcast di La7 e TG La7 condotto da Paolo Celata, che ti accompagna in un viaggio attraverso la storia delle elezioni europee","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/cover.jpeg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/1qxcYSpUxuaBNgyNjbk5lh?si=4e6d4711442346d0","https://podcasts.apple.com/it/podcast/euro-dieci/id1749545648","https://youtube.com/playlist?list=PLTQLA-sdhEzSWfOEpxYSMxDfrZavNL_P1&si=I_9-yQDWzsmP2SM5","https://music.amazon.it/podcasts/7c394dca-9cf7-4d8b-88fa-45f562de10f5/euro-dieci"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":16,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/voicetown/podcast#podcast-series","name":"Voicetown","url":"https://www.la7play.it/voicetown/podcast","description":"Voicetown, dove le pagine prendono vita dalla voce dei loro autori","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1746691132/voicetown_podcast_cover_1400x1400.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/5NDVsFBpNP6gcQdwRyTEj1?si=059713e24c06454f","https://podcasts.apple.com/it/podcast/voicetown/id1565105956","https://music.amazon.it/podcasts/9ade5ae1-8e89-44b5-80b5-fd2250326b79/voicetown"],"publisher":{"@id":"https://www.la7play.it/#organization"}}},{"@type":"ListItem","position":17,"item":{"@type":"PodcastSeries","@id":"https://www.la7play.it/finale-di-partito/podcast#podcast-series","name":"Finale di partito","url":"https://www.la7play.it/finale-di-partito/podcast","description":"Un tempo i partiti italiani contavano milioni di iscritti, distribuivano potere e lavoro, ma anche ideali, formazione, comunità. Oggi, sono lontani da quei numeri e da quel ruolo. “Finale di Partito” è il nuovo podcast di La7, scritto da Alessandra Sardoni, che racconta la fine dei grandi partiti della Prima Repubblica. Un viaggio in quattro episodi – tra testimonianze dirette e analisi storiche – per ripercorrere l’ultimo giorno di Democrazia Cristiana, Partito Comunista Italiano, Partito Socialista Italiano e Movimento Sociale Italiano. Una riflessione sulla parabola dei partiti di massa, il potere che avevano e quello che hanno perso. Ma soprattutto, una domanda semplice che apre a una storia complessa: qual è stato il loro ultimo giorno?","image":{"@type":"ImageObject","url":"https://images.la7play.it/media/c/t1762792030/1400-1306.jpg/img/1400x1400.webp","width":1400,"height":1400},"sameAs":["https://open.spotify.com/show/5WtZsdOGdEkagddo4sip6r?si=4b58a47d15494909","https://youtube.com/playlist?list=PLTQLA-sdhEzQVFz0pmQ4Oi1gS3wxe_HFv&si=j8JnrtHuCH4KMrwH","https://music.amazon.it/podcasts/db321049-c62b-48cc-823e-7109b1e2dce8/finale-di-partito","https://podcasts.apple.com/it/podcast/finale-di-partito/id1819528429"],"publisher":{"@id":"https://www.la7play.it/#organization"}}}]}]}</script><div class="flex flex-col h-full w-full pt-16"><div class="mt-0 w-full max-w-[1280px] mx-auto  z-10" data-luminosa="la7"><h1 class="text-fg-default text-3xl font-semibold font-[&#x27;Wallop-TRIAL&#x27;] leading-9 pb-3">Podcast</h1><div class="text-fg-default text-sm font-normal font-manrope leading-5"><h3>I podcast di LA7 ovunque con te</h3><p>Il meglio di La7, tutto da ascoltare. Scopri i nostri podcast, scegli i tuoi preferiti e ascoltali quando vuoi su <strong>Spotify</strong>, <strong>Apple </strong>Podcasts, <strong>YouTube </strong>Music e <strong>Amazon </strong>Music.</p></div><div class="grid grid-cols-5 gap-6 pt-6"><a href="/buongiornomondo/podcast" class="cursor-pointer" data-la7-tid="295"><div class="relative rounded-lg aspect-square"><img src="https://images.la7play.it/media/c/t1746691132/1400.jpg/img/400x400.webp" alt="BuongiornoMondo" class="absolute inset-0 h-full w-full object-cover rounded-lg" loading="lazy" decoding="async" width="400" height="400"/></div></a><a href="/tgla7/podcast" class="cursor-pointer" data-la7-tid="545"><div class="relative rounded-lg aspect-square"><img src="https://images.la7play.it/media/c/t1790925247/property/podcast/tg.jpg/img/400x400.webp" alt="Tg La7" class="absolute inset-0 h-full w-full object-cover rounded-lg" loading="lazy" decoding="async" width="400" height="400"/></div></a><a hr