<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>La7 Play</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { height:100%; }
  body {
    background:#0a0a0a;
    color:#ffffff;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    display:flex; align-items:center; justify-content:center;
    min-height:100vh; text-align:center; padding:24px;
  }
  .box { display:flex; flex-direction:column; align-items:center; max-width:640px; width:100%; }
  .logo { width:150px; height:auto; margin-bottom:28px; }
  h1 { font-size:1.6rem; font-weight:600; letter-spacing:.2px; margin-bottom:28px; line-height:1.3; }
  .btn {
    display:inline-block; background:#2a2a2a; color:#ffffff;
    border:none; border-radius:6px; padding:12px 26px;
    font-size:.95rem; font-weight:500; cursor:pointer;
    text-decoration:none; transition:background .15s ease;
  }
  .btn:hover, .btn:focus { background:#3a3a3a; outline:none; }
  @media (max-width:600px) {
    body { padding:20px; }
    .logo { width:108px; margin-bottom:22px; }
    h1 { font-size:1.2rem; margin-bottom:24px; }
    .btn { padding:11px 22px; font-size:.9rem; }
  }
</style>
</head>
<body>
  <div class="box">
    <img class="logo" src="data:image/png;base64," alt="La7 Play">
    <h1>Spiacenti, si &egrave; verificato un errore</h1>
    <a class="btn" href="/" onclick="location.reload();return false;">Ricarica la pagina</a>
  </div>
</body>
</html>
